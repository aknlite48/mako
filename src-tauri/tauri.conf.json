{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Mako",
	"version": "0.2.0",
	"identifier": "com.aanand.mako",
	"build": {
		"frontendDist": "../dist"
	},
	"plugins": {
		"fs": {
			"requireLiteralLeadingDot": false
		}
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "Mako",
				"width": 1200,
				"height": 800,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "app",
		"icon": ["icons/icon.icns", "icons/icon.png"]
	}
}
