{
	"name": "mako",
	"private": true,
	"version": "0.1.0",
	"description": "A low-memory code editor with Git Graph built in",
	"license": "MIT",
	"scripts": {
		"build": "esbuild backend/bootstrap.ts --bundle --minify --format=iife --outfile=dist/backend.js && cp index.template.html dist/index.html && cp node_modules/@xterm/xterm/css/xterm.css dist/xterm.css",
		"check": "tsc --noEmit --strict --target es2020 --module esnext --moduleResolution node --skipLibCheck backend/bootstrap.ts",
		"test": "vitest run",
		"tauri": "tauri"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/lang-rust": "^6.0.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/merge": "^6.12.2",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.5",
		"@codemirror/view": "^6.43.12",
		"@lezer/highlight": "^1.2.3",
		"@replit/codemirror-indentation-markers": "^6.5.3",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2",
		"@tauri-apps/plugin-fs": "^2.5.2",
		"@tauri-apps/plugin-opener": "^2.5.5",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2",
		"@vscode/codicons": "^0.0.46-24",
		"esbuild": "^0.27.7",
		"seti-icons": "^0.0.4",
		"typescript": "^5",
		"vitest": "^5.0.5"
	},
	"allowScripts": {
		"esbuild@0.27.7": true
	}
}
